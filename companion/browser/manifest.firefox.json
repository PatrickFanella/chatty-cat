{
  "manifest_version": 3,
  "name": "Chatty Cat watched-channel companion",
  "version": "0.1.4",
  "description": "Explicitly send the active Twitch channel to a paired Chatty Cat tab.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://chat.subcult.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.subcult.tv/*"
      ],
      "js": [
        "firefox-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatty-cat-companion@subcult.tv",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  }
}
